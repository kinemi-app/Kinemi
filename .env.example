# ComfyUI endpoint; empty means demo mode. A local ComfyUI: http://127.0.0.1:8188.
# Comfy Cloud: https://cloud.comfy.org/api (the /api part is required).
COMFY_URL=
# Comfy Cloud: your API key, sent as X-API-Key. Another ComfyUI: a Bearer token for an
# authenticating proxy, or empty when it needs none.
COMFY_API_KEY=
# auto uses ComfyUI when COMFY_URL is set, cloud requires it, local always uses the demo generator.
GENERATION_MODE=auto
# SQLite file for the studio's chats; empty means ~/.kinemi/kinemi.sqlite, served to this computer only.
# Set it on a server other people reach: every visitor then shares the chats in this file.
KINEMI_DB=
# off keeps npm start on every interface (for a public host) and turns the chat's Claude Code / Codex
# bridge off. Empty: Next listens on 127.0.0.1 only and the chat can use the CLIs on this computer.
KINEMI_LOCAL_CLI=
# OpenAI-compatible LLM endpoint for the studio planner, for example https://api.example.com/v1.
LLM_URL=
# Bearer token for the LLM endpoint.
LLM_API_KEY=
# Model name the planner sends to LLM_URL.
LLM_MODEL=
# Command that synthesizes speech outside ComfyUI; empty means the demo tone.
KINEMI_TTS_CMD=
# Slack incoming webhook for connector notifications; empty means connectors stay local.
SLACK_WEBHOOK_URL=
# Notion integration token for the Notion connector.
NOTION_TOKEN=
# Notion database that receives the connector's rows.
NOTION_DATABASE_ID=
# Google Drive access token for the Drive connector.
GDRIVE_TOKEN=
# ffmpeg binary for the MP4 export; empty looks for ffmpeg on PATH.
KINEMI_FFMPEG_PATH=
# Gated Hugging Face weights (FLUX.1-schnell, LTX-2.5) need a token, but not here: scripts/comfy-install.mjs does not read .env.
# Accept each licence on huggingface.co, then run `export HF_TOKEN=...` in the shell before scripts/comfy-install.mjs. Do not put it in .env.
