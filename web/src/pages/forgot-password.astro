---
import Page from '../layouts/Page.astro';
import AuthArt from '../components/AuthArt.astro';
import AuthForms from '../app/auth/AuthForms';
---

<Page title="Forgot your password" description="Get a link to set a new Kinemi password.">
  <div class="auth">
    <AuthForms client:load mode="forgot" />
    <AuthArt word="RETAKE" take="TAKE 02" line="It happens to every director. We’ll send a link to set a new one." />
  </div>
</Page>
