---
// A named picture slot. Shows src/assets/screens/<name>.* when it exists, otherwise an empty,
// labeled viewfinder that says what belongs there and at what size.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { SHOTS, type ShotName } from '../data/shots';

interface Props {
  name: ShotName;
  /** sizes attribute for the responsive image */
  sizes?: string;
  class?: string;
  /** slot fills its parent instead of using its own aspect ratio */
  fill?: boolean;
  eager?: boolean;
}

const { name, sizes = '(max-width: 760px) 90vw, 50vw', class: className, fill = false, eager = false } = Astro.props;
const spec = SHOTS[name];
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const match = Object.entries(files).find(([path]) => path.replace(/^.*\//, '').replace(/\.[^.]+$/, '') === name);
const image = match?.[1].default;
const style = fill ? undefined : `aspect-ratio:${spec.ratio}`;
---

{
  image ? (
    <Picture
      src={image}
      alt={spec.alt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[480, 800, 1200, 1600, 2400].filter((w) => w <= image.width)}
      sizes={sizes}
      class:list={['shot', 'shot-img', { 'shot-fill': fill }, className]}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={style}
    />
  ) : (
    <div class:list={['shot', 'shot-empty', { 'shot-fill': fill }, className]} style={style} role="img" aria-label={`Placeholder for ${spec.label.toLowerCase()}`} data-shot={name}>
      <i class="shot-corner tl" />
      <i class="shot-corner tr" />
      <i class="shot-corner bl" />
      <i class="shot-corner br" />
      <span class="shot-meta">
        <svg class="shot-mark" viewBox="0 0 4 3" aria-hidden="true">
          <path d="M0 0h2v1H0zM1 1h2v1H1zM2 2h2v1H2z" fill="currentColor" />
        </svg>
        <span class="shot-label">{spec.label}</span>
        <span class="shot-file">
          screens/{name}.png · {spec.size}
        </span>
      </span>
    </div>
  )
}

<style>
  .shot {
    display: block;
    width: 100%;
  }

  .shot-fill {
    height: 100%;
  }

  :global(img.shot),
  .shot-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot-empty {
    --c: rgba(57, 216, 121, 0.55);
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(57, 216, 121, 0.08), transparent 60%),
      radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1.2px) 0 0 / 14px 14px,
      linear-gradient(160deg, #0f2133, #0a1622 60%, #08121c);
  }

  /* a slow sheen, like light passing over glass */
  .shot-empty::after {
    content: '';
    position: absolute;
    inset: -50% -100%;
    background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.05) 50%, transparent 58%);
    animation: sheen 6.5s var(--ease-in-out) infinite;
    animation-delay: calc(var(--sheen-delay, 0) * 1s);
  }

  @keyframes sheen {
    0%,
    30% {
      transform: translateX(-40%);
    }
    80%,
    100% {
      transform: translateX(40%);
    }
  }

  .shot-corner {
    position: absolute;
    width: clamp(8px, 6cqw, 16px);
    aspect-ratio: 1;
    border: 0 solid var(--c);
  }

  .tl {
    top: 8%;
    left: 8%;
    border-width: 1.5px 0 0 1.5px;
  }

  .tr {
    top: 8%;
    right: 8%;
    border-width: 1.5px 1.5px 0 0;
  }

  .bl {
    bottom: 8%;
    left: 8%;
    border-width: 0 0 1.5px 1.5px;
  }

  .br {
    bottom: 8%;
    right: 8%;
    border-width: 0 1.5px 1.5px 0;
  }

  .shot-meta {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.5em;
    padding: 0 10%;
    text-align: center;
    font-size: clamp(8px, 4.2cqw, 13px);
  }

  .shot-mark {
    width: 2.2em;
    color: var(--green-400);
    opacity: 0.9;
  }

  .shot-label {
    color: var(--fg);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .shot-file {
    color: var(--fg-3);
    font-family: var(--font-mono);
    font-size: 0.78em;
    letter-spacing: 0.02em;
  }

  @container (max-width: 140px) {
    .shot-file {
      display: none;
    }
  }
</style>
