---
import PixelText from './PixelText.astro';
import Button from './Button.astro';
import HandStage from './HandStage.astro';
import { SITE } from '../data/site';
---

<section class="hero" id="top" data-spy-target>
  <div class="hero-card" data-hero>
    <div class="hero-bg" aria-hidden="true">
      <span class="glow glow-a"></span>
      <span class="glow glow-b"></span>
      <span class="glow glow-c"></span>
      <span class="hero-scan"></span>
    </div>

    <h1 class="sr-only">Kinemi: real camera language for AI film</h1>

    <div class="hero-word" data-hero-word>
      <PixelText text="KINEMI" mode="cells" decorative stops={['#f3fff8', '#c4f5d9', '#6fe2a1', '#2fc56d']} />
    </div>

    <HandStage />

    <div class="hero-foot">
      <p class="hero-tagline" data-hero-line>
        <span>Real camera language</span>
        <span>for every AI shot.</span>
      </p>
      <Button href={SITE.appUrl} class="hero-cta" data-hero-line>Try Kinemi for free</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    height: 100vh;
    height: 100svh;
    min-height: 620px;
    max-height: 1040px;
    padding: 80px var(--gutter) var(--gutter);
    transform-origin: 50% 0;
  }

  /* as the page scrolls on, the hero recedes like a monitor being pushed back */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hero {
        animation: hero-out linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }

      @keyframes hero-out {
        to {
          transform: scale(0.9);
          opacity: 0.2;
        }
      }
    }
  }

  /* the card powers on */
  :global(.js) .hero-card {
    animation: card-in 1.1s var(--ease-out) both;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      translate: 0 18px;
      scale: 0.985;
    }
  }

  .hero-card {
    --pad: clamp(16px, 2.3vw, 34px);
    container-type: size;
    position: relative;
    height: 100%;
    border-radius: var(--r-xl);
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, #03080e 0%, #050d16 34%, #08192a 70%, #0a2232 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.13),
      0 40px 120px -40px rgba(57, 216, 121, 0.25);
    transform-origin: 50% 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .glow-a {
    left: -18%;
    bottom: -38%;
    width: 72%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(36, 185, 100, 0.62), rgba(20, 90, 55, 0.28) 55%, transparent);
    animation: drift-a 18s var(--ease-in-out) infinite alternate;
  }

  .glow-b {
    left: 26%;
    bottom: -62%;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(13, 95, 134, 0.75), rgba(10, 47, 82, 0.35) 55%, transparent);
    animation: drift-b 22s var(--ease-in-out) infinite alternate;
  }

  .glow-c {
    right: -20%;
    bottom: -30%;
    width: 64%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(46, 230, 196, 0.42), rgba(15, 143, 136, 0.22) 55%, transparent);
    animation: drift-c 20s var(--ease-in-out) infinite alternate;
  }

  /* portrait cards (phones, tablets): bigger, rounder glows */
  @container (max-aspect-ratio: 1 / 1) {
    .glow-a {
      left: 0;
      bottom: -18%;
      width: 100%;
    }

    .glow-b {
      left: 0;
      bottom: -40%;
      width: 100%;
    }

    .glow-c {
      right: 0;
      bottom: -10%;
      width: 100%;
    }
  }

  .hero-scan {
    /* faint horizontal scanlines, like a monitor in a dark grading suite */
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.018) 0 1px, transparent 1px 4px);
    mask-image: linear-gradient(180deg, transparent, #000 40%, #000 80%, transparent);
  }

  @keyframes drift-a {
    to {
      transform: translate3d(8%, -6%, 0) scale(1.08);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate3d(-10%, -4%, 0) scale(1.12);
    }
  }

  @keyframes drift-c {
    to {
      transform: translate3d(-6%, -8%, 0) scale(0.94);
    }
  }

  .hero-word {
    position: absolute;
    inset: var(--pad) var(--pad) auto var(--pad);
    z-index: 1;
  }

  .hero-word :global(svg) {
    width: 100%;
  }

  .hero-word :global(.px) {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 0.55s var(--ease-out),
      fill-opacity 0.4s;
  }

  /* the word assembles pixel by pixel, left to right with a little noise */
  :global(.js) .hero-word :global(.px) {
    animation: px-in 0.8s var(--ease-out) backwards;
    animation-delay: calc(140ms + var(--x) * 16ms + var(--r) * 320ms);
  }

  @keyframes px-in {
    from {
      opacity: 0;
      transform: translate3d(0, -0.9px, 0) scale(0.2);
    }
  }

  /* tagline and button rise in after the word */
  :global(.js) .hero-foot :global([data-hero-line]) {
    animation: rise 1s var(--ease-out) backwards;
    animation-delay: 0.9s;
  }

  :global(.js) .hero-foot :global(.btn[data-hero-line]) {
    animation-delay: 1.05s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 24px, 0);
      filter: blur(8px);
    }
  }

  .hero-foot {
    position: absolute;
    inset: auto var(--pad) var(--pad) var(--pad);
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    pointer-events: none;
  }

  .hero-foot > :global(*) {
    pointer-events: auto;
  }

  .hero-tagline {
    display: grid;
    font-size: clamp(22px, 2.35vw, 34px);
    line-height: 1.15;
    font-weight: 450;
    letter-spacing: -0.025em;
  }

  .hero-tagline span:last-child {
    color: rgba(242, 247, 244, 0.86);
  }

  @media (max-width: 760px) {
    .hero {
      height: auto;
      max-height: none;
      min-height: 0;
      padding-top: 76px;
    }

    .hero-card {
      /* The 560px floor made a 9:16 card wider than the 288px column at 320px. */
      inline-size: 100%;
      height: auto;
      aspect-ratio: 9 / 16;
      max-height: 88svh;
      min-height: 0;
    }

    .hero-card :global(.hand-stage) {
      left: 50%;
      width: 100%;
      height: auto;
      transform: translateX(-50%);
    }

    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  import { initHero } from '../scripts/hero';
  initHero();
</script>
