---
interface Props {
  href: string;
  variant?: 'light' | 'ghost' | 'green';
  arrow?: boolean;
  class?: string;
  magnetic?: boolean;
  [key: string]: unknown;
}
const { href, variant = 'light', arrow = true, class: className, magnetic = true, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn-${variant}`, className]} data-magnetic={magnetic ? '' : undefined} {...rest}>
  <span class="btn-label"><slot /></span>
  {
    arrow && (
      <span class="btn-arrow" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14">
          <path d="M4.5 11.5l7-7M5.5 4.5h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg viewBox="0 0 16 16" width="14" height="14">
          <path d="M4.5 11.5l7-7M5.5 4.5h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )
  }
</a>

<style>
  .btn {
    --mx: 0px;
    --my: 0px;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px 0 20px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    isolation: isolate;
    transform: translate3d(var(--mx), var(--my), 0);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.3s,
      color 0.3s,
      box-shadow 0.4s var(--ease-out);
  }

  .btn-label {
    position: relative;
    transform: translate3d(calc(var(--mx) * 0.25), calc(var(--my) * 0.25), 0);
    transition: transform 0.5s var(--ease-out);
  }

  .btn-light {
    background: #fff;
    color: var(--ink-1);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 8px 24px -12px rgba(57, 216, 121, 0.5);
  }

  .btn-light:hover {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 10px 34px -10px rgba(57, 216, 121, 0.75);
  }

  .btn-green {
    background: var(--green-400);
    color: var(--ink-1);
  }

  .btn-ghost {
    color: #fff;
    background: rgba(255, 255, 255, 0.02);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.55);
    height: 38px;
    padding: 0 16px;
    font-size: 14px;
  }

  .btn-ghost::before {
    /* a light sweep that runs along the outline on hover */
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--sweep, 0deg), transparent 0 70%, var(--green-400) 85%, transparent 100%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s;
    z-index: -1;
  }

  .btn-ghost:hover::before {
    opacity: 1;
    animation: sweep 1.6s linear infinite;
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .btn-arrow {
    position: relative;
    display: grid;
    width: 14px;
    height: 14px;
    overflow: hidden;
  }

  .btn-arrow svg {
    grid-area: 1 / 1;
    transition: transform 0.45s var(--ease-out);
  }

  .btn-arrow svg + svg {
    transform: translate(-130%, 130%);
  }

  .btn:hover .btn-arrow svg:first-child {
    transform: translate(130%, -130%);
  }

  .btn:hover .btn-arrow svg + svg {
    transform: none;
    transition-delay: 0.06s;
  }

  .btn:active {
    transform: translate3d(var(--mx), var(--my), 0) scale(0.97);
  }

  @property --sweep {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes sweep {
    to {
      --sweep: 360deg;
    }
  }
</style>
