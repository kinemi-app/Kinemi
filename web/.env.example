# Copy this file to .env (or set the same variables in your host's dashboard) and fill in what you need.
# Leave everything empty and Kinemi runs as a studio on this computer: no accounts, nothing on a server.

# --- Accounts (the web version) -------------------------------------------------------------
# From your Supabase project: the project URL (https://<project>.supabase.co) and the publishable key
# (Project Settings → API Keys). Both are meant for the browser.
PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…). An older anon key works too, as PUBLIC_SUPABASE_ANON_KEY.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# on (default): people can use the studio as a guest; their work stays in their own browser.
# off: everyone signs in first. Only has an effect when the Supabase keys above are set.
PUBLIC_GUEST_MODE=on

# Extra sign-in buttons, for providers you switched on in Supabase → Authentication → Providers.
# Comma-separated: google, github, apple, discord, gitlab
PUBLIC_AUTH_PROVIDERS=

# --- Links -----------------------------------------------------------------------------------
# Where the website's "Launch App" buttons point, when the studio is hosted somewhere else.
PUBLIC_APP_URL=
# Comfy Cloud's API. Change it only to go through a proxy of your own.
PUBLIC_COMFY_CLOUD_URL=https://cloud.comfy.org

# --- Build -----------------------------------------------------------------------------------
# Your site's address, for canonical and social links: https://kinemi.example
SITE_URL=
